---
import { href, site } from '../config/site';
---
<footer class="footer shell">
  <p>© {new Date().getFullYear()} Akram Naser</p>
  <nav aria-label="Footer links">
    <a href={href('play')}>Play</a>
    <a href={href('blog')}>Blog</a>
    <a href={href('contact')}>Contact</a>
    <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
    {site.linkedin && <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>}
  </nav>
</footer>
<style>
  .footer { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: 2rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.8rem; }
  .footer p { margin: 0; }
  .footer nav { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .footer a { text-decoration: none; }
  .footer a:hover { color: var(--ink); }
  @media (max-width: 650px) { .footer { align-items: flex-start; flex-direction: column; gap: 1rem; } }
</style>
