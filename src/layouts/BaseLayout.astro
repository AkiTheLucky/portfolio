---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader';
import SiteFooter from '../components/SiteFooter.astro';
import { href, site } from '../config/site';
import heroPreview from '../assets/art/sky.jpg';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title = site.title, description = site.description, type = 'website', publishedTime } = Astro.props;
const canonical = Astro.url.href;
const siteRoot = new URL(href(), Astro.site ?? Astro.url).href;
const socialImage = new URL(href('og.png'), Astro.site ?? Astro.url).href;
const fontCss = `
  @font-face {
    font-family: 'Maxitype Modelo';
    src: url('${href('fonts/modelo/Modelo-Light.woff2')}') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Maxitype Modelo';
    src: url('${href('fonts/modelo/Modelo-Regular.woff2')}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Maxitype Modelo';
    src: url('${href('fonts/modelo/Modelo-Bold.woff2')}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Maxitype Modelo';
    src: url('${href('fonts/modelo/Modelo-Black.woff2')}') format('woff2');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }
`;
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteRoot}#person`,
  name: site.name,
  url: siteRoot,
  description,
  mainEntityOfPage: canonical,
  knowsAbout: ['Business process improvement', 'AI adoption', 'Automation', 'AI education'],
  sameAs: [site.github, site.linkedin].filter(Boolean),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="preload" as="image" href={heroPreview.src} fetchpriority="high" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Akram Naser — process improvement and AI adoption" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <style is:inline set:html={fontCss} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('akram-theme');
          const theme = saved === 'dark' || saved === 'light'
            ? saved
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader client:load currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
