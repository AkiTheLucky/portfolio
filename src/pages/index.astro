---
import { getCollection } from 'astro:content';
import HomePage from '../components/HomePage';
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ id: entry.id, ...entry.data }));
const education = (await getCollection('education'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ id: entry.id, ...entry.data }));
const questions = (await getCollection('fermi')).map((entry) => ({
  id: entry.id,
  ...entry.data,
  explanation: entry.body?.trim() || '',
}));
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    pubDate: new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(entry.data.pubDate),
  }));
---
<BaseLayout>
  <HomePage
    client:load
    experiences={experience}
    education={education}
    questions={questions}
    posts={posts}
    clickEndpoint={import.meta.env.PUBLIC_CLICK_COUNTER_URL || ''}
  />
</BaseLayout>
