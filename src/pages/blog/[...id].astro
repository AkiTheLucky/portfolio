---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../config/site';
import { postSlug } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const seen = new Set<string>();
  return posts.map((post) => {
    const id = postSlug(post.id);
    if (seen.has(id)) throw new Error(`Two blog posts resolve to the slug "${id}". Rename one.`);
    seen.add(id);
    return { params: { id }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} — Akram Naser`} description={post.data.description}>
  <article class="page-content shell prose">
    <p class="prose-meta"><a href={href('blog')}>Blog</a> · <time datetime={post.data.pubDate.toISOString()}>{new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(post.data.pubDate)}</time></p>
    <h1>{post.data.title}</h1>
    <p class="prose-lead">{post.data.description}</p>
    <Content />
  </article>
</BaseLayout>
