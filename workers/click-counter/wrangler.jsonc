{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-click-counter",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:4321"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "Counter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Counter"]
    }
  ]
}
